# Quantify — Environment Configuration (Copy to .env.local or configure in Vercel)

# Canonical public URL (used for sitemap.xml, robots.txt, JSON-LD, OG URLs, and embeds)
NEXT_PUBLIC_SITE_URL=https://quantify-ashen.vercel.app

# Optional: Receive instant Studio Early Access waitlist signups in Slack, Discord, Make, Zapier, or n8n
# Supports Discord webhooks, Slack incoming webhooks, or any generic JSON POST endpoint
STUDIO_WEBHOOK_URL=

# Optional: Send instant email alerts via Resend (https://resend.com)
RESEND_API_KEY=
STUDIO_NOTIFY_EMAIL=
STUDIO_FROM_EMAIL=Quantify Studio <onboarding@resend.dev>

# Optional: Forward lightweight privacy-safe feature telemetry events (compare_toggle, embed_open, share_copy, etc.)
TELEMETRY_WEBHOOK_URL=

# Optional: Search engine ownership verification tokens (Google Search Console / Bing Webmaster Tools)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
